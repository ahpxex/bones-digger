# ===================================================================
# 骨鉴 OSTEOGNOSIS — environment variables
# Copy to .env.local and fill in values to switch from mock to real APIs.
# ===================================================================

# --- AI provider switch --------------------------------------------
# "mock"      : no external calls, deterministic output per upload id
# "doubao"    : Doubao VLM + doubao-embedding via Volcengine ARK (default in prod)
# "dashscope" : legacy — Qwen3.5 + Qwen3-Embedding via Alibaba DashScope
AI_PROVIDER=mock

# --- Doubao (Volcengine ARK) ---------------------------------------
# Get keys at: https://console.volcengine.com/ark
ARK_API_KEY=
# OpenAI-compatible endpoint.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Dual channel runs on one model — the realtime pass sends thinking:disabled,
# the deep pass thinking:enabled. Override per channel only if wiring a lighter
# realtime model (ARK_VLM_MODEL_REALTIME / ARK_VLM_MODEL_THINKING).
ARK_VLM_MODEL=doubao-seed-2-1-pro-260628
# Doubao's reasoning pass takes minutes, so the deep channel is OFF by default
# (every upload uses the fast single pass). Set to "on" to escalate low-confidence
# samples to a second thinking pass — accept much higher latency if you do.
ARK_THINKING_CHANNEL=off
# Abort deadlines (ms) bounding each channel. The deep pass needs a long one.
ARK_REALTIME_TIMEOUT_MS=60000
ARK_THINKING_TIMEOUT_MS=180000
# Embedding model for RAG retrieval (returns a fixed 4096-dim vector).
ARK_EMBEDDING_MODEL=doubao-embedding-large-text-240915

# Confidence threshold that triggers the thinking channel (0–1). Default 0.72.
THINKING_CHANNEL_THRESHOLD=0.72

# --- DashScope (legacy Qwen provider, AI_PROVIDER=dashscope) --------
# Get keys at: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# OpenAI-compatible endpoint. Singapore: dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VLM_MODEL_REALTIME=qwen3.5-flash
DASHSCOPE_VLM_MODEL_THINKING=qwen3.5-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024

# --- Persistent production storage --------------------------------
# Required on Vercel. Connect a Vercel Blob store to the project so uploads,
# generated images, GLB meshes, and analysis JSON survive serverless runtime.
BLOB_READ_WRITE_TOKEN=

# --- SAM 3.1 segmentation ------------------------------------------
# "stub"      : synthesize a soft-vignette image (no network)
# "replicate" : call real SAM 3 / 3.1 via Replicate
SAM_PROVIDER=stub
REPLICATE_API_TOKEN=
REPLICATE_SAM_VERSION=meta/sam-3

# --- SAM 3D Objects (single-image to GLB mesh) ---------------------
# "none"      : skip 3D reconstruction (default, fast)
# "fal"       : use fal.ai hosted endpoint (FAL_KEY required)
# "replicate" : use Replicate hosted SAM 3D (REPLICATE_API_TOKEN required)
# "stub"      : placeholder mesh only (no network call)
SAM3D_PROVIDER=none
FAL_KEY=
REPLICATE_SAM3D_VERSION=facebookresearch/sam-3d-objects
